# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# RevenueCat Configuration (v1 Monetization)
# For Shipaton / Next Gen (No Store Account Required), use RevenueCat Test Store key:
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_revenuecat_test_store_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_key

# RevenueCat Webhook Secret (used in Supabase Edge Functions)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret
