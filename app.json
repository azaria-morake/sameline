{
  "expo": {
    "name": "SameLine",
    "slug": "sameline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sameline",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A192F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sameline.kasi",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SameLine uses your location to discover tournaments in Katlehong, Vosloorus, and nearby grounds within 20km.",
        "NSPhotoLibraryUsageDescription": "Allow SameLine to access your photos to upload team logos and player badges."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A192F"
      },
      "package": "com.sameline.kasi",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SameLine uses your location to discover football tournaments near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SameLine to access your photos to upload your team logo."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "230e7756-5453-4e7a-b49e-119f68e85e5d"
      }
    },
    "owner": "ux-giants"
  }
}
